BOT_TOKEN=your_bot_token_here
BOT_PROXY=
DOWNLOAD_DIR=app/media/audio/cache
FFMPEG_PATH=/usr/bin/ffmpeg
DATABASE_PATH=app/data/bot.db
MAX_DURATION_SECONDS=1200
SEARCH_RESULTS_LIMIT=10
SEARCH_PER_PLATFORM=5
MP3_BITRATE=192
BIRTHDAY_ANNOUNCE_HOUR=10
TELEGRAM_REQUEST_TIMEOUT=60
TELEGRAM_CONNECT_RETRIES=5
TELEGRAM_CONNECT_RETRY_DELAY=3.0

# SPEED OPTIMIZATIONS (опционально)
# Количество параллельных фрагментов при скачивании (по умолчанию: 8)
YTDLP_CONCURRENT_FRAGMENTS=8
# Размер чанка HTTP в байтах (по умолчанию: 10MB)
YTDLP_CHUNK_SIZE=10485760
# Размер буфера в байтах (по умолчанию: 16MB)
YTDLP_BUFFER_SIZE=16777216
